# --- OS / editor junk ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Local tooling / skills (installed locally, not versioned) ---
.claude/

# --- AI-assist local config — keep AI-development footprint out of this public repo ---
# Guidance for local AI tooling lives in CLAUDE.local.md and is never committed.
CLAUDE.md
CLAUDE.local.md

# --- dependencies / logs ---
node_modules/
*.log

# --- Platform pivot (server-of-one) — local runtime data + real config (secrets) ---
# The server's on-disk store and the real config (with secrets) stay local; only the
# code + the safe example config are versioned.
server/verso-server.config.json
server/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# --- build artifacts (regenerated; don't version) ---
desktop/Verso.app/
export/build/

# =====================================================================
# COURSE CONTENT — keep local, never commit
# Real course snapshots, packages and assets are the author's data and
# should stay out of the repo. For a demo, add a scrubbed sample, not real content.
# =====================================================================
*.versopub.json
# Explicit: the Viewer is a dev harness and must never carry a real course payload.
viewer/*.versopub.json
viewer/*.json
*.scorm
*_SCORM.zip
*.zip

# Real course data (CSV source + generators). The bundled template
# (course_schema_template.csv) is safe and NOT matched here.
course-*.csv
course-*.json

# dev scratch / diagnostics at root
_diag-*.html
__*.html

# Repro/debug screenshots may capture course content — keep them out of the repo.
references/

# Local review/comment exchange sidecars
review-*.json
verso-comments*.json

# --- Working material — local only ---
# Non-shipping scratch: prototypes, spikes, design specs, audits, restructure notes.
# See the repository-boundary table in README.md: workbench/ is the one gitignored role.
workbench/
